# Flooding on the fast preset region-meshtastic-fast.tsim, region-meshcore-fast.tsim and
# region-distvec-fast.tsim share (MSH-66): SF7 at 125 kHz, coding rate 4/5, a 16-symbol preamble.
# Every node relays, three hops, behind ALOHA - the floor. It has no sites to share. SF8 is
# -s radio.sf=8 -s sites.sf=8, which tools/density.py --fast --sf 8 sets for every candidate.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 7
radio.bw       = 125000
radio.cr       = 1
radio.preamble = 16
radio.tx_dbm   = 20

routing       = flood
routing.hops  = 3
mac           = aloha
mac.max_delay = 2 s

# The sub-band's 10%, held by every radio, as in region-deployed.tsim.
duty_cycle = 10%

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

# As region.tsim: six hours to settle, the last three carrying traffic, and one measured.
warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
