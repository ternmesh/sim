# Candidate 3 deployed as region-meshcore-deployed.tsim is: the same radio, MeshCore's UK/EU narrow
# preset, and the same 200 sites as relays, the rest leaves its relays keep routes to. No oracle:
# leaves are routed, as a real network would have to route them; -s routing.leaves=parent_oracle
# gives the ceiling a lookup of each leaf's relay, never wrong and never late, would allow.
#
# Measured with tools/density.py --deployed (3 seeds, -5 to 20 dBm; MSH-63), unicast on time:
#   flooding                        11-14%    every node relaying, on this preset
#   meshtastic, LongFast            14% falling to 1% as density rises
#   meshtastic, MediumFast          17-39%, 7% at 20 dBm
#   meshcore, 200 repeaters         15% falling to 7%
#   candidate 3, links sensed       13% falling to 5%
#   candidate 3, links by strength  29-41% (the default since), broadcast 1-16%
#   the same with parent_oracle     12-31%: the lookup does not help here
# Every candidate is overloaded at this preset and this traffic, a message from each node every
# half hour: the slow presets real meshes run carry far less than SF7 or SF8 at 125 kHz, where
# region-distvec.tsim's candidate 3 delivered 93-99% of unicasts with both oracles.
#
# With their firmware's own traffic on (MSH-64), as the deployed incumbents now run: meshtastic
# on LongFast 11-12% falling to 1.5%, on MediumFast 14-33% and 7% at 20 dBm; meshcore unchanged.
# With a message from each node every 2 h instead (-s traffic.interval=2h), unicast on time, and
# broadcast after the slash:
#   flooding                        22-39% / 21-38%
#   meshtastic, LongFast            19-29%, 5% at 20 dBm / 5-27%
#   meshtastic, MediumFast          16-64% / 17-63%
#   meshcore, 200 repeaters         21-39% / 8-16%
#   candidate 3                     76-88% / 27-48%
# Without their own traffic Meshtastic made 35-41% on LongFast and 23-74% on MediumFast: its own
# traffic costs it more than the workload's once the channel has room for it.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 8
radio.bw       = 62500
radio.cr       = 4
radio.preamble = 32
radio.tx_dbm   = 20

routing             = distvec
mac                 = meshcore
routing.relay_pick  = cds
routing.relay_count = 200
# The sites are picked over links at MeshCore's narrow preset, whatever this run's preset, so
# every deployed candidate - and any run of one on another preset - gets the same 200.
sites.sf            = 8
sites.bw            = 62500

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

# As region.tsim: six hours to settle, the last three carrying traffic, and one measured.
warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
