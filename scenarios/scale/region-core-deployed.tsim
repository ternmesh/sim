# The firmware's core (tsim/core.h) on the deployed preset, over the 200 shared sites, as
# region-distvec-deployed.tsim. No traffic: see scenarios/core/town.tsim.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 8
radio.bw       = 62500
radio.cr       = 4
radio.preamble = 32
radio.tx_dbm   = 20

routing             = core
mac                 = listen
routing.relay_pick  = cds
routing.relay_count = 200
sites.sf            = 8
sites.bw            = 62500

duty_cycle = 10%

traffic.interval  = none

warmup       = 6 h
duration     = 1 h
