# Candidate 3 on the radio settings the firmware ships for US915, AU915 and NZ915 (the
# specification's draft/phy.md): SF9 at 500 kHz, coding rate 4/5, a 16-symbol preamble and no limit
# on transmitting, and otherwise as region-distvec-fast.tsim - 200 sites, picked at these settings,
# as relays. The pair of region-core-us915.tsim (tools/core.py).
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 9
radio.bw       = 500000
radio.cr       = 1
radio.preamble = 16
radio.tx_dbm   = 20

routing             = distvec
mac                 = meshcore
routing.relay_pick  = cds
routing.relay_count = 200
sites.sf            = 9
sites.bw            = 500000

# The sub-band's 10%, held by every radio, as in region-distvec-deployed.tsim.

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

# As region.tsim: six hours to settle, the last three carrying traffic, and one measured.
warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
