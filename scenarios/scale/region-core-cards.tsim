# Presence cards on the firmware's core (tsim/core.h), deployed preset, over the 200 shared sites,
# as region-core-deployed.tsim, with the region's message load and every node sending a signed
# card an hour (cards.len = 96 is a 123-byte frame). tools/cards.py sweeps it against the same
# load without cards, and against a public room of the same shape: see the spec's draft/cards.md.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 8
radio.bw       = 62500
radio.cr       = 4
radio.preamble = 32
radio.tx_dbm   = 20

routing             = core
mac                 = listen
routing.relay_pick  = cds
routing.relay_count = 200
sites.sf            = 8
sites.bw            = 62500

duty_cycle = 10%

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

cards.interval = 1 h
cards.len      = 96

warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
