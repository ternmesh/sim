# Candidate 2 as it is deployed: region-meshcore.tsim on MeshCore's UK/EU narrow preset - SF8 at
# 62.5 kHz, coding rate 4/8, the 32-symbol preamble MeshCore 1.17 programs at SF8 and below - with
# 200 repeaters, the rest companions, which never relay, rather than every node a repeater. The
# repeaters are sited by a greedy connected dominating set over the links the radio has, and
# region-meshtastic-deployed.tsim's routers and region-distvec-deployed.tsim's relays on the same
# sites.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 8
radio.bw       = 62500
radio.cr       = 4
radio.preamble = 32
radio.tx_dbm   = 20

routing             = meshcore
mac                 = meshcore
routing.relay_pick  = cds
routing.relay_count = 200
# The firmware's own traffic as well: each repeater floods its advert every 47 h (MSH-64), which
# changes nothing measurable. Companions send adverts only when their users ask, so none here.
routing.background  = yes
# The sites are picked over links at MeshCore's narrow preset, whatever this run's preset, so
# every deployed candidate - and any run of one on another preset - gets the same 200.
sites.sf            = 8
sites.bw            = 62500

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

# As region.tsim: six hours to settle, the last three carrying traffic, and one measured.
warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
