# The first field test's drive (2026-11-21, firmware v0.7.0-alpha.3). Every board starts in one
# house, every link strong (drive.links). Ten minutes in, the relays go to their places: the desk
# relay (0) stays, the patio relay (1) is a few hundred yards off, and three more (2 to 4) are
# further up the hill, which reach the desk only through the patio. At the end of the warmup the leaf (5) is driven away: out of reach of the
# desk and of the hill, and still heard well by the patio relay alone. Then the leaf and the desk
# write to each other, a message every four minutes each way, for 100 minutes.
#
# On the boards the desk kept the leaf in use for 35 minutes and more, sent it everything direct,
# and sent the acknowledgement of a message that came through another relay back direct, where it
# was lost (ternmesh/spec#81). What is measured is unicast delivered each way, and how many of the
# leaf's messages it gave up on though they arrived: their acknowledgements lost. The drive.yml
# workflow runs this against two firmware commits, each way apart, and prints both.
nodes  = 6
links  = drive.links

radio.sf     = 9
radio.bw     = 500000
radio.tx_dbm = 22

routing            = core
routing.relay_pick = degree
routing.relay_count = 5
mac                = listen

# The relays go to their places: the patio relay a few hundred yards from the house, the hill's
# further on, out of the desk's reach indoors and in the leaf's, which is still outside the house.
link.set = 10 min, 0, 1, 110
link.set = 10 min, 0, 2, 160
link.set = 10 min, 0, 3, 162
link.set = 10 min, 0, 4, 165
link.set = 10 min, 1, 2, 112
link.set = 10 min, 1, 3, 118
link.set = 10 min, 1, 4, 120
link.set = 10 min, 2, 3, 105
link.set = 10 min, 2, 4, 108
link.set = 10 min, 3, 4, 104
link.set = 10 min, 5, 1, 110
link.set = 10 min, 5, 2, 120
link.set = 10 min, 5, 3, 122
link.set = 10 min, 5, 4, 125
# The leaf drives away: the patio relay alone still hears it.
link.set = 40 min, 5, 0, 170
link.set = 40 min, 5, 1, 125
link.set = 40 min, 5, 2, 170
link.set = 40 min, 5, 3, 170
link.set = 40 min, 5, 4, 170

traffic.interval  = none
traffic.broadcast = 0
traffic.send = 42 min, 5, 0, 20
traffic.send = 44 min, 0, 5, 20
traffic.send = 46 min, 5, 0, 20
traffic.send = 48 min, 0, 5, 20
