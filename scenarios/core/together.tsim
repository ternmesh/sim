# Two nodes that hear each other well, each sending the other a message at the same instant. Both
# listen first, as a radio can (tsim/listen.h), and neither has anything to hear when it looks:
# their frames meet. What is measured is whether they meet again at every try (MSH-89):
#
#   tsim scenarios/core/together.tsim                             both arrive
#   tsim -s routing.retry_jitter=0 scenarios/core/together.tsim   neither does, after 8 frames each
#
# Over 200 seeds, messages delivered and frames sent for each, by routing.retry_jitter, listening
# first and, with -s mac=aloha -s "mac.max_delay=0 s", not listening at all, as the Heltec V3 port
# ran when this was found:
#
#        listening                        not listening
#        SF9, 500 kHz    SF11, 250 kHz    SF9, 500 kHz    SF11, 250 kHz
#    0     0%  8.0          0%  8.0         0%  8.0          0%  8.0
#    1   100%  2.3        100%  2.3        49%  7.0         51%  7.0
#    2   100%  2.2        100%  2.2        94%  4.5         96%  4.7
#    4   100%  2.2        100%  2.2       100%  3.0        100%  3.0
#    8   100%  2.1        100%  2.1       100%  2.4        100%  2.3
#   16   100%  2.0        100%  2.0       100%  2.2        100%  2.2
#
# A node that listens holds its second try for the other's, if that began first; one that does not
# sends over it. With mac = meshcore both arrive whatever the setting: that model notices a frame
# the instant it starts, which no radio does.
nodes     = 2
placement = line
spacing   = 200

radio.sf      = 9
radio.bw      = 500000
radio.tx_dbm  = 2
channel.sigma = 0

routing       = core
mac           = listen

traffic.interval  = none
traffic.broadcast = 0
traffic.send      = 610 s, 0, 1, 20
traffic.send      = 610 s, 1, 0, 20

warmup   = 10 min
duration = 1 min
deadline = 60 s
