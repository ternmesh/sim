# Two nodes that hear each other well, each sending the other a message at the same instant, and
# neither listening before it sends: a board as the Heltec V3 port runs, which has no
# listen-before-talk. Their frames meet. What is measured is whether they meet again at every try
# (MSH-89):
#
#   tsim scenarios/core/together.tsim                          both arrive
#   tsim -s routing.retry_jitter=0 scenarios/core/together.tsim   neither does, after 8 frames each
#
# Over 200 seeds, messages delivered and frames sent for each, by routing.retry_jitter:
#
#        SF9, 500 kHz    SF11, 250 kHz
#    0     0%  8.0          0%  8.0
#    1    49%  7.0         51%  7.0
#    2    94%  4.5         96%  4.7
#    4   100%  3.0        100%  3.0
#    8   100%  2.4        100%  2.3
#   16   100%  2.2        100%  2.2
#
# With mac = meshcore, which listens first, both arrive whatever the setting: the model notices a
# frame the instant it starts, which no radio does.
nodes     = 2
placement = line
spacing   = 200

radio.sf      = 9
radio.bw      = 500000
radio.tx_dbm  = 2
channel.sigma = 0

routing       = core
mac           = aloha
mac.max_delay = 0 s

traffic.interval  = none
traffic.broadcast = 0
traffic.send      = 610 s, 0, 1, 20
traffic.send      = 610 s, 1, 0, 20

warmup   = 10 min
duration = 1 min
deadline = 60 s
