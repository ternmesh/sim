# The DM-heavy workload (MSH-34): metro.tsim with six direct messages a node a day, seven in ten
# answered, so that the unicast question MSH-27 asked stays answerable under the field's
# background. Two to ten a day is the range the field allows without measuring it: see
# docs/workload.md.
nodes     = 1000
placement = uniform
area      = 18000 x 18000

radio.sf       = 7
radio.bw       = 125000
radio.cr       = 1
radio.preamble = 16
radio.tx_dbm   = 20

routing             = core
mac                 = listen
routing.relay_pick  = cds
routing.relay_count = 200
sites.sf            = 7
sites.bw            = 125000

duty_cycle = 10%

# No plain process: the flows below are the whole workload.
traffic.interval = none
traffic.peers    = 4
traffic.reply_delay = 2 min

# Who is about: Meshtastic's NodeInfo every 3 h (Bay Mesh about 10 a node a day, with replies).
flow.presence.interval = 3 h
flow.presence.timer    = yes
flow.presence.len      = 96
flow.presence.reach    = 5000

# Position about 7 a node a day (Bay Mesh), 28 bytes.
flow.position.interval = 206 min
flow.position.timer    = yes
flow.position.len      = 28
flow.position.reach    = 5000

# Device telemetry about 3 a node a day (Bay Mesh), 28 bytes.
flow.telemetry.interval = 8 h
flow.telemetry.timer    = yes
flow.telemetry.len      = 28
flow.telemetry.reach    = 5000

# The public channel: 0.22 lines a node a day (Bay Mesh), from the 17% of nodes that write at
# all, 8 to 50 bytes (a mean of 29, the main channel's).
flow.chat.interval = 18 h
flow.chat.share    = 0.17
flow.chat.len      = 8..50

# Direct messages to regular correspondents: six a node a day, seven in ten answered.
flow.dm.interval = 4 h
flow.dm.to       = peer
flow.dm.reply    = 0.7
flow.dm.len      = 8..50

# Emergency: an alert to every node from 2% of them, one each every 2 h. A probe, not a rate -
# the field's are too rare to measure in an hour - to see whether an alert gets through the load.
flow.emergency.interval = 2 h
flow.emergency.share    = 0.02
flow.emergency.len      = 40

# As the region: six hours to settle, the last three carrying traffic, and one measured.
warmup       = 6 h
traffic.lead = 3 h
duration     = 1 h
deadline     = 60 s
