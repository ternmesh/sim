# The town scenario under candidate 3: distance-vector routing over MeshCore's dispatcher, every
# node infrastructure.
nodes     = 200
placement = uniform
area      = 8000 x 8000

radio.sf     = 9
radio.bw     = 125000
radio.tx_dbm = 20

routing = distvec
mac     = meshcore

traffic.interval  = 30 min
traffic.len       = 16..64
traffic.broadcast = 0.25

# Three hours to settle, the same for every candidate: candidate 3's tables hold 98% of routes by
# then, and 48% after ten minutes. Airtime is counted from when traffic starts; the warmup's is
# reported apart.
warmup   = 3 h
duration = 1 h
deadline = 60 s
